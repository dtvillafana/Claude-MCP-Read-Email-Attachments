# ============================================================================
# M365 Attachment Reader MCP - Environment Configuration
# ----------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# Do NOT commit your real .env (it is already in .gitignore).
# ============================================================================

# ----------------------------------------------------------------------------
# M365_CLIENT_ID  (REQUIRED)
# ----------------------------------------------------------------------------
# The Application (client) ID of your Microsoft Entra app registration.
# Get it from: https://entra.microsoft.com -> App registrations -> your app
# -> Overview -> "Application (client) ID".
#
# This is a public identifier, not a secret. It is safe to leave visible.
M365_CLIENT_ID=YOUR_APPLICATION_CLIENT_ID

# ----------------------------------------------------------------------------
# M365_TENANT_ID  (optional, default: "common")
# ----------------------------------------------------------------------------
# Which authentication endpoint to use. Valid values:
#
#   common         - Work/school accounts from ANY tenant AND personal MS
#                    accounts. Most flexible. REQUIRES your Entra app to be
#                    set to "Any Entra ID Tenant + Personal Microsoft
#                    accounts" AND requestedAccessTokenVersion = 2 in the
#                    manifest. See README step 4.
#
#   consumers      - Personal Microsoft accounts only (@outlook.com,
#                    @hotmail.com, @live.com, Xbox, Skype, etc.).
#
#   organizations  - Any work/school account, no personal accounts.
#
#   <your-tenant>  - A specific tenant GUID or domain
#                    (e.g. "contoso.onmicrosoft.com"). Use this if your app
#                    is single-tenant.
M365_TENANT_ID=common

# ----------------------------------------------------------------------------
# M365_AUTO_OPEN_BROWSER  (optional, default: "true")
# ----------------------------------------------------------------------------
# When "true", begin_auth automatically opens your default browser to the
# Microsoft device login page. When "false", you must open the URL manually
# using the output from begin_auth.
#
# Set to "false" if you are running headless (Docker, SSH, CI) or simply
# do not want the browser to pop up on its own.
M365_AUTO_OPEN_BROWSER=true

# ----------------------------------------------------------------------------
# M365_MCP_DATA_DIR  (optional, usually leave empty)
# ----------------------------------------------------------------------------
# Override the directory where debug.log is written. If left blank, the
# server auto-selects the first writable location from this list:
#   1. %LOCALAPPDATA%\m365-attachment-reader-mcp-local   (Windows)
#      ~/.m365-attachment-reader-mcp-local                (macOS/Linux)
#   2. A ".m365-attachment-reader-mcp-local" folder next to server.mjs
#
# Only set this if you need logs in a specific location (e.g. a mounted
# Docker volume).
M365_MCP_DATA_DIR=

# ----------------------------------------------------------------------------
# M365_SEND_MAX_BYTES  (optional, default: 3145728 = 3 MB)
# ----------------------------------------------------------------------------
# Total size budget for attachments sent by the send_outlook_email tool. This
# build inlines attachments in a single Microsoft Graph request, so the value
# must stay under Graph's ~4 MB request limit (base64 inflates files by ~33%).
# Files >= 3 MB always require the chunked upload-session flow, which is not
# enabled in this version. Leave blank to use the 3 MB default.
M365_SEND_MAX_BYTES=

# ----------------------------------------------------------------------------
# M365_SEND_ALLOWED_DIRS  (optional, default: empty = any readable path)
# ----------------------------------------------------------------------------
# Optional allowlist of base directories that send_outlook_email may read
# attachment files from. When set, any file outside these roots is rejected.
# Use the OS path separator to list multiple roots:
#   macOS/Linux:  /Users/me/Desktop:/Users/me/Documents
#   Windows:      C:\Users\me\Desktop;C:\Users\me\Documents
# Leave blank to allow any path the OS user can read.
M365_SEND_ALLOWED_DIRS=
